# PostgreSQL connection (Neon / Vercel Postgres / Supabase).
# Use the POOLED connection string for the app:
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection — used by Prisma for migrations:
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret for signing auth tokens. Generate: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Seed admin account (created by `npm run seed`)
ADMIN_EMAIL="admin@articulem.app"
ADMIN_PASSWORD="admin12345"
